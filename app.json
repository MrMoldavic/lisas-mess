{
  "expo": {
    "name": "Lisa's Mess",
    "slug": "lisas-mess",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lisasmess",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6EBDA",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lisasmess.app"
    },
    "android": {
      "package": "com.lisasmess.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Lisa's Mess utilise l'appareil photo pour ajouter un vêtement à ta garde-robe.",
          "photosPermission": "Lisa's Mess accède à tes photos pour importer un vêtement existant."
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lisa's Mess utilise ta position pour que Bobine t'annonce la météo du jour."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
