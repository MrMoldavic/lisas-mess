# Les variables exposées au bundle doivent être préfixées par EXPO_PUBLIC_.
# COPIER ce fichier en .env (ne pas le renommer, ce modèle est versionné).

EXPO_PUBLIC_API_URL=https://api.example.com

# Détourage automatique des photos. Éteint par défaut : le mettre à "true"
# seulement une fois le compte Replicate crédité, sinon chaque photo déclenche
# un appel qui échoue.
EXPO_PUBLIC_CUTOUT_ENABLED=false

# Jeton Replicate (https://replicate.com/account/api-tokens).
# ATTENTION : toute variable EXPO_PUBLIC_ est embarquée en clair dans le bundle
# de l'app. Acceptable pour un usage personnel sur ton propre téléphone ;
# à remplacer par un proxy côté serveur avant toute distribution.
EXPO_PUBLIC_REPLICATE_API_TOKEN=
